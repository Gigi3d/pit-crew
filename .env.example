# Copy to .env and fill in. Nothing here is needed for the mock race or the live
# console; they run with no keys. These are for the Friday swap to real services.

DAYTONA_API_KEY=          # app.daytona.io
FIREWORKS_API_KEY=        # app.fireworks.ai/settings/users/api-keys
BRAINTRUST_API_KEY=       # braintrust.dev  (starts sk-)
ELEVENLABS_API_KEY=       # elevenlabs.io
ELEVENLABS_VOICE_ID=      # pick a clipped, radio-like voice and paste its id

# CodeRabbit Discord challenge. The Pit Crew bot posts the winning PR here.
DISCORD_WEBHOOK_URL=      # team channel: Settings > Integrations > Webhooks > New
PITCREW_PR_URL=           # the winning PR on the source repo, e.g. github.com/Gigi3d/widget-api/pull/2
