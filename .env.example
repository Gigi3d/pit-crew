# Copy to .env and fill in. Never commit .env.
# Put values directly after the "=" with no trailing comment on the same line.

# app.daytona.io
DAYTONA_API_KEY=

# app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=

# braintrust.dev (starts with sk-)
BRAINTRUST_API_KEY=

# elevenlabs.io
ELEVENLABS_API_KEY=


# --- Optional overrides; defaults match SETUP.md ---

# Fireworks' recommended high-throughput model (SETUP.md section 3).
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3p1

# Must match the project you create in the Braintrust dashboard.
# BRAINTRUST_PROJECT=pitcrew

# Snapshot name and where widget-api lives, for build_snapshot.py.
# DAYTONA_SNAPSHOT=pitcrew-widget-api
# WIDGET_API_PATH=../widget-api

# Hard-code your crew voice tonight (SETUP.md section 5) - do not browse the
# voice library on stage.
# ELEVENLABS_VOICE_ID=
