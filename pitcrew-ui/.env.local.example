# Copy to .env.local for local dev; set the same in Vercel's dashboard for prod.
# All server-side only (no NEXT_PUBLIC_ prefix) so they never reach the browser.

FIREWORKS_API_KEY=          # powers the CopilotKit runtime
DISCORD_WEBHOOK_URL=        # where "approve the winner" posts the PR
ELEVENLABS_API_KEY=         # optional: voice replies
ELEVENLABS_VOICE_ID=        # optional

# Public (safe to expose). Point the demo PR link at a repo you own.
NEXT_PUBLIC_PR_URL=https://github.com/Gigi3d/widget-api/pull/1
NEXT_PUBLIC_SIM_REPO=Gigi3d/widget-api
# NEXT_PUBLIC_ENGINE_URL=   # set only if you host the Python engine separately
